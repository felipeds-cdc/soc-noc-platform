{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "jsx": "react-jsx",

    "moduleResolution": "bundler",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}