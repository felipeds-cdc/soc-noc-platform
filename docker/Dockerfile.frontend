FROM node:20-slim AS builder

WORKDIR /app
# context é ./frontend — sem prefixo nos caminhos
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# nginx.conf deve estar em frontend/nginx.conf no host
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
