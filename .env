# SOC/NOC Platform - Environment Variables Example
# Este arquivo é opcional, pois as variáveis já estão definidas no docker-compose.yml
# Copie para .env e personalize se necessário

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# PostgreSQL
POSTGRES_DB=soc_noc
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_password123
DATABASE_URL=postgresql+asyncpg://soc_user:soc_password123@postgres:5432/soc_noc

# Backend
SECRET_KEY=change-this-in-production-secret-key
JWT_ALGORITHM=HS256

# Honeypot
HONEYPOT_PORT=2222
HONEYPOT_HOST=0.0.0.0

# Agent
LOG_FILES=/var/log/auth.log,/var/log/syslog
