# ==========================================
# SOC/NOC Platform - Environment Variables (LOCAL)
# ==========================================
# Este arquivo .env é para desenvolvimento local.
# Em produção, use senhas fortes e únicas.

APP_NAME=SOC/NOC Platform API
DEBUG=true

POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_dev_password_CHANGE_ME
POSTGRES_DB=soc_noc
DATABASE_URL=postgresql+asyncpg://soc_user:soc_dev_password_CHANGE_ME@postgres:5432/soc_noc

REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Gere uma chave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-generate-random

JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc@localhost.local
SMTP_TO=admin@localhost.local

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

GEOIP_ENABLED=true
ANONYMIZE_LOGS=false
