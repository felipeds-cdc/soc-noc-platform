# ==========================================
# SOC/NOC Platform - Environment Variables
# ==========================================
# Copie este arquivo para .env e personalize os valores.
# NUNCA commite o .env no repositório.

# App
APP_NAME=SOC/NOC Platform API
DEBUG=true

# Database — ALTERE para senhas seguras em produção
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=<GERAR_SENHA_ALEATORIA>
POSTGRES_DB=soc_noc
DATABASE_URL=postgresql+asyncpg://soc_user:<GERAR_SENHA_ALEATORIA>@postgres:5432/soc_noc

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# JWT Auth — GENERE uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GERAR_CHAVE_ALEATORIA>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (opcional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc@localhost.local
SMTP_TO=admin@localhost.local

# Webhooks (opcional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# GeoIP
GEOIP_ENABLED=true

# Anonymization
ANONYMIZE_LOGS=false
